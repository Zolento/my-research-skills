# 参考文献库的生成物（按需保留，默认不提交缓存与大文件）
docs/refs/cache/*.json
!docs/refs/cache/.gitkeep
docs/refs/papers/*.json
docs/refs/papers/*.md
!docs/refs/papers/.gitkeep

# PDF 原文是大文件，不进版本库；
# 但 docs/refs/index.json（PDF 索引）**必须**进版本库，故此处不忽略它。
docs/refs/**/*.pdf

# 机器状态
.research-idea-pipeline/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
