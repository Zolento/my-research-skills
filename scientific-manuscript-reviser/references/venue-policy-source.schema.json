{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "venue-policy-source@1",
  "description": "A curated verbatim excerpt of one official venue policy source. Offline verification companion for venue-policy-profile@1: every quote in a profile must occur verbatim in the excerpt of the source it cites.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "venue", "year", "url", "source_type", "retrieved", "excerpt"],
  "properties": {
    "schema": {"const": "venue-policy-source@1"},
    "id": {"type": "string", "minLength": 1},
    "venue": {"type": "string", "minLength": 1},
    "year": {"type": "integer", "minimum": 2024},
    "url": {"type": "string", "pattern": "^https?://"},
    "source_type": {
      "enum": ["author_guidelines", "reviewer_guidelines", "review_form", "call_for_papers",
               "ethics_policy", "reproducibility_guidelines", "submission_requirements",
               "code_of_conduct", "official_faq"]
    },
    "retrieved": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "excerpt": {"type": "string", "minLength": 200},
    "note": {"type": "string"}
  }
}
