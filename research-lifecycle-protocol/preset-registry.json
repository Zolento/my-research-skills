            "when": "domain_declared",
            "load": [
              "domain-profiles/<profile>/PROFILE.md"
            ]
          }
        ],
        "deep_references": [
          "references/operational-autonomy-policy.md",
          "references/scientific-communication-policy.md",
          "references/scheduler-policy.md#next_action_policy",
          "references/research-state-policy.md#5. 写入时机",
          "references/phase-r9-r11-experiment-loop.md"
        ],
        "domain_extensions": [
          "mri-reconstruction"
        ],
        "forbidden": [
