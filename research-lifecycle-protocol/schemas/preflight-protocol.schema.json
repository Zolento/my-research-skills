{
  "type": "object",
  "required": [
    "schema",
    "mode",
    "claims",
    "competitors",
    "risk_controls",
    "arms",
    "comparisons",
    "intervention",
    "evaluation",
    "outcomes",
    "conditions",
    "budget_hours",
    "pilot",
    "scientific_review",
    "human_exception"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "preflight-protocol@1"
    },
    "mode": {
      "type": "string",
      "enum": [
        "formal",
        "pilot",
        "exploratory",
        "sanity",
        "calibration"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "risk_controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "risk_id",
          "disposition",
          "comparison_ids",
          "owner",
          "reason",
          "limited_scope",
          "excluded_scope",
          "repair_index"
        ],
        "additionalProperties": false,
        "properties": {
          "risk_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "DESIGN_CONTROL",
              "DISCRIMINATING_CONTROL",
              "SCOPE_LIMIT",
              "UNIDENTIFIABLE"
            ]
          },
          "comparison_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "limited_scope": {
            "type": "string",
            "minLength": 1
          },
          "excluded_scope": {
            "type": "string",
            "minLength": 1
          },
          "repair_index": {
            "type": "integer",
            "minimum": -1
          }
        }
      },
      "minItems": 0
    },
    "arms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "trainable_parameters",
          "training_dof",
          "compute_hours",
          "data_split",
          "optimization",
          "intervention"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "method",
              "baseline",
              "control"
            ]
          },
          "trainable_parameters": {
            "type": "integer",
            "minimum": 0
          },
          "training_dof": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "compute_hours": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "data_split": {
            "type": "string",
            "minLength": 1
          },
          "optimization": {
            "type": "object",
            "required": [
              "optimizer",
              "lr",
              "schedule",
              "batch",
              "steps",
              "tuning_trials",
              "diagnostics"
            ],
            "additionalProperties": false,
            "properties": {
              "optimizer": {
                "type": "string",
                "minLength": 1
              },
              "lr": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "schedule": {
                "type": "string",
                "minLength": 1
              },
              "batch": {
                "type": "integer",
                "minimum": 1
              },
              "steps": {
                "type": "integer",
                "minimum": 1
              },
              "tuning_trials": {
                "type": "integer",
                "minimum": 1
              },
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          },
          "intervention": {
            "type": "object",
            "required": [
              "variable",
              "dose"
            ],
            "additionalProperties": false,
            "properties": {
              "variable": {
                "type": "string",
                "minLength": 1
              },
              "dose": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      },
      "minItems": 0
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "left",
          "right",
          "controlled_variables",
          "contrast_variables",
          "measurement",
          "predictions"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "left": {
            "type": "string",
            "minLength": 1
          },
          "right": {
            "type": "string",
            "minLength": 1
          },
          "controlled_variables": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "contrast_variables": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "measurement": {
            "type": "string",
            "minLength": 1
          },
          "predictions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "hypothesis_id",
                "observation",
                "decision"
              ],
              "additionalProperties": false,
              "properties": {
                "hypothesis_id": {
                  "type": "string",
                  "minLength": 1
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                },
                "decision": {
                  "type": "string",
                  "enum": [
                    "CONTINUE",
                    "REDESIGN",
                    "PIVOT",
                    "STOP",
                    "HOLD",
                    "RETRY"
                  ]
                }
              }
            },
            "minItems": 2
          }
        }
      },
      "minItems": 0
    },
    "intervention": {
      "type": "object",
      "required": [
        "definition",
        "frozen",
        "dose_levels",
        "observable",
        "manipulation_check"
      ],
      "additionalProperties": false,
      "properties": {
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "frozen": {
          "type": "boolean"
        },
        "dose_levels": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 1
        },
        "observable": {
          "type": "string",
          "minLength": 1
        },
        "manipulation_check": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evaluation": {
      "type": "object",
      "required": [
        "data_split",
        "seeds",
        "metric",
        "min_effect",
        "statistics"
      ],
      "additionalProperties": false,
      "properties": {
        "data_split": {
          "type": "string",
          "minLength": 1
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "min_effect": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "statistics": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outcomes": {
      "type": "object",
      "required": [
        "support",
        "refute",
        "uncertain",
        "invalid"
      ],
      "additionalProperties": false,
      "properties": {
        "support": {
          "type": "object",
          "required": [
            "criterion",
            "decision",
            "preregistration_id"
          ],
          "additionalProperties": false,
          "properties": {
            "criterion": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "type": "string",
              "enum": [
                "CONTINUE",
                "REDESIGN",
                "PIVOT",
                "STOP",
                "HOLD",
                "RETRY"
              ]
            },
            "preregistration_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "refute": {
          "type": "object",
          "required": [
            "criterion",
            "decision",
            "preregistration_id"
          ],
          "additionalProperties": false,
          "properties": {
            "criterion": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "type": "string",
              "enum": [
                "CONTINUE",
                "REDESIGN",
                "PIVOT",
                "STOP",
                "HOLD",
                "RETRY"
              ]
            },
            "preregistration_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "uncertain": {
          "type": "object",
          "required": [
            "criterion",
            "decision",
            "preregistration_id"
          ],
          "additionalProperties": false,
          "properties": {
            "criterion": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "type": "string",
              "enum": [
                "CONTINUE",
                "REDESIGN",
                "PIVOT",
                "STOP",
                "HOLD",
                "RETRY"
              ]
            },
            "preregistration_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "invalid": {
          "type": "object",
          "required": [
            "criterion",
            "decision",
            "preregistration_id"
          ],
          "additionalProperties": false,
          "properties": {
            "criterion": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "type": "string",
              "enum": [
                "CONTINUE",
                "REDESIGN",
                "PIVOT",
                "STOP",
                "HOLD",
                "RETRY"
              ]
            },
            "preregistration_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "conditions": {
      "type": "object",
      "required": [
        "failure",
        "stop",
        "redesign"
      ],
      "additionalProperties": false,
      "properties": {
        "failure": {
          "type": "string",
          "minLength": 1
        },
        "stop": {
          "type": "string",
          "minLength": 1
        },
        "redesign": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "budget_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "pilot": {
      "type": "object",
      "required": [
        "goal",
        "measurement",
        "max_runs",
        "max_hours",
        "stop",
        "decisions"
      ],
      "additionalProperties": false,
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "measurement": {
          "type": "string",
          "minLength": 1
        },
        "max_runs": {
          "type": "integer",
          "minimum": 1
        },
        "max_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stop": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "hypothesis_id",
              "observation",
              "decision"
            ],
            "additionalProperties": false,
            "properties": {
              "hypothesis_id": {
                "type": "string",
                "minLength": 1
              },
              "observation": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "enum": [
                  "CONTINUE",
                  "REDESIGN",
                  "PIVOT",
                  "STOP",
                  "HOLD",
                  "RETRY"
                ]
              }
            }
          },
          "minItems": 2
        }
      }
    },
    "scientific_review": {
      "type": "object",
      "required": [
        "status",
        "reviewer",
        "reason",
        "design_digest",
        "execution_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "design_digest": {
          "type": "string",
          "minLength": 1
        },
        "execution_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "human_exception": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "reviewer",
        "reason",
        "scope",
        "expires_at",
        "max_hours"
      ],
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution protocol on an existing experiment"
}
